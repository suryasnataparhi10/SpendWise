PORT=5000
# MongoDB connection string, including the database name. For Atlas:
# mongodb+srv://user:password@cluster.example.mongodb.net/spendwise_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise_app
# Optional: database name, if it is not part of MONGODB_URI.
# MONGODB_DB=spendwise_app

# Required only when running the one-time PostgreSQL -> MongoDB migration script:
# DATABASE_URL=postgresql://username:password@localhost:5432/spendwise
# Legacy pre-PostgreSQL MongoDB database (the migration script refuses to write into it):
# MONGO_URI=mongodb://127.0.0.1:27017/spendwise
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

CRON_SECRET=

# Configure Gmail SMTP (including an app password) for reset and scheduled emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database Migration & Portability Center (website: Administration > Migration center).
# Comma-separated emails of the accounts allowed to use it. Leave empty to disable it.
ADMIN_EMAILS=
# Key for encrypting server-held backups and staged imports. Set a long random value and keep
# it stable (if unset, a key derived from JWT_SECRET is used, so rotating JWT_SECRET would make
# existing backups unreadable).
MIGRATION_ENCRYPTION_KEY=
# Optional: largest package that can be uploaded, in MB (default 200).
# MIGRATION_MAX_UPLOAD_MB=200
# When DATABASE_URL is set, the PostgreSQL database also appears in the migration center as a
# source/destination (PostgreSQL <-> MongoDB).

# Destination for hidden-expense PIN recovery links.
HIDDEN_EXPENSE_RECOVERY_EMAIL=
